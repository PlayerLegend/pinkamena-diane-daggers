[sub_resource type="GDScript" id="GDScript_pn0hk"]
script/source = "class_name Xtal
extends SlideBody3D

@export_group(\"Physics Layers\")
@export_flags_3d_physics var enemies_layer: int
@export_flags_3d_physics var pickups_layer: int
@onready var rollback_synchronizer: RollbackSynchronizer = $RollbackSynchronizer

var health: int = 10

signal xtal_died(xtal: Xtal)

func _ready() -> void:
    collision_layer = enemies_layer

func take_damage(amount: int):
    if not health:
        print(\"Xtal took damage but is dead\")
        return
    
    health -= amount
    if health <= 0:
        health = 0
        top_level = true
        collision_layer = pickups_layer
        xtal_died.emit(self)

func _helper_find_player() -> PlayerController:
    var dist = INF
    var result = null
    for player in get_tree().get_nodes_in_group(\"players\"):
        assert(player is PlayerController)
        var player_dist = (player.global_position - global_position).length_squared()
        if player_dist < dist:
            result = player
            dist = player_dist
    return result

func _rollback_tick(delta: float, _tick, _is_fresh):
    
    #delta *= NetworkTime.physics_factor
    
    if not is_multiplayer_authority() and _is_fresh:
        return
    
    if top_level:
        var player := _helper_find_player()
        rotation.lerp(Vector3(0,0,0), delta)
        if player:
            var wishdir = (player.global_position - global_position).normalized()
            var wishvel = 10 * wishdir
            var fric = velocity.slide(wishdir)
            velocity = velocity.lerp(wishvel, delta / 3)
            velocity -= fric * delta
        move_and_slide(delta)
        
"

