shader_type canvas_item;

uniform sampler2D screen_render : filter_nearest;

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

float quantize(float value, float steps) {
    return floor(value * steps) / steps;
}

void vertex() {
	// Called for every vertex the material is visible on.
}

void fragment() {
    vec3 in_rgb = texture(screen_render, UV).xyz;
    vec3 in_hsv = rgb2hsv(in_rgb);
    vec3 out_hsv = in_hsv;
    out_hsv.z = quantize(out_hsv.z, 6);
    COLOR = vec4(hsv2rgb(out_hsv), 1.0);
	// Called for every pixel the material is visible on.
}

