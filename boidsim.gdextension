[configuration]
entry_symbol = "boidsim_init"
compatibility_minimum = "4.2"

[libraries]
windows.debug.x86_64 = "res://bin/libBoidCPP.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libBoidCPP.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libBoidCPP.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libBoidCPP.linux.template_release.x86_64.so"
web.debug.wasm32 = "res://bin/libBoidCPP.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://bin/libBoidCPP.web.template_release.wasm32.nothreads.wasm"