[configuration]
entry_symbol = "centipede_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/libCentipedeCPP.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libCentipedeCPP.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libCentipedeCPP.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libCentipedeCPP.linux.template_release.x86_64.so"
